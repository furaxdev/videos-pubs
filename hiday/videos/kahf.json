     "at": 0,
     "scene": "time_lapse"
    }
   ],
   "hl": [
    "années",
    "soleil"
   ]
  },
  {
   "text": "Quand le soleil se levait, il s'écartait de leur grotte, et quand il se couchait, il les évitait.",
